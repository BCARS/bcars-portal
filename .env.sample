# BCARS portal secret-environment sample. The binaries do not load this file;
# export the values through your shell or process supervisor.
# Non-secret runtime configuration currently uses command-line flags. Supported
# deployment packaging and environment-variable configuration are deferred to
# bcars-portal-fmc.8.

# Required by the server in production. Generate with: openssl rand -base64 32
PORTAL_PASSWORD_PEPPER=

# Required when the server uses --mail-transport=smtp.
PORTAL_SMTP_PASSWORD=

# Required by portalctl backup and restore. Keep it separately from backups.
PORTAL_BACKUP_PASSPHRASE=
