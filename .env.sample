# BCARS portal configuration sample.
# Copy to .env and fill in. Never commit a populated .env.
# See docs/phase-1-design.md §12 for the authoritative list.

PORTAL_LISTEN_ADDR=:8080
PORTAL_DB_PATH=./data/portal.db

PORTAL_SESSION_COOKIE_NAME=bcars_portal
PORTAL_SESSION_TTL=168h
PORTAL_SESSION_RECENT_AUTH_TTL=5m

# Required in production. Generate with: openssl rand -base64 32
PORTAL_PASSWORD_PEPPER=

# Mail: 'smtp' for production, 'filelog' for dev/tests.
PORTAL_MAIL_MODE=filelog
PORTAL_MAIL_SMTP_HOST=
PORTAL_MAIL_SMTP_PORT=587
PORTAL_MAIL_SMTP_USER=
PORTAL_MAIL_SMTP_PASSWORD=
PORTAL_MAIL_FROM=portal@bcars.org
PORTAL_MAIL_REPLY_TO=qsl@bcars.org
PORTAL_MAIL_FILELOG_DIR=./data/mail

# Logging: debug, info, warn, error
PORTAL_LOG_LEVEL=info

# Trust an upstream proxy's X-Request-Id / X-Forwarded-For only when true.
PORTAL_TRUST_PROXY_HEADER=false
