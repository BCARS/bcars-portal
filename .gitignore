# Build output
/bin/
/dist/
# Binaries built at the repository root, which is what `go build ./cmd/...`
# produces when it is run without -o. One of these was committed by an `git add
# -A` and reached main (13 MB), so the pattern is named rather than relying on
# remembering to clean up.
/portal
/portalctl
/portalctl-demo
*.test
*.out

# Local environment (sample is committed)
.env
.env.*
!.env.sample

# SQLite database and WAL/SHM sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Real BCARS data. Never commit any of these.
/data/
/backups/
/uploads/
/extracted/
/transcripts/

# The walkthrough's screenshots are committed under docs/screenshots/ (see that
# directory's README). This rule covers the old default output directory, and
# any run that overrides OUT_DIR back to it: a stray copy outside the reviewed
# location should not be committable, because no gate can read a PNG and an
# image taken against real member data cannot be removed from history.
/ui-shots/

# Seeded development portal built by `make run-demo`. Throwaway synthetic data,
# but it is still a database and a mail spool, so it never belongs in git.
/demo-data/

# Design mockups and working material supplied out of band. CLAUDE.md already
# describes this directory as ignored, but nothing enforced it, and the copy
# in use holds a real contact-database export.
/scratch/

# IDE / OS
.DS_Store
.idea/
.vscode/
.claude/worktrees/
*.swp

# Coverage
coverage.out
coverage.html

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
